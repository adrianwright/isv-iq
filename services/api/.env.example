# Runtime
APP_ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
DATA_DIR=../../data

# Connected-provider gates. scripts/dev.ps1 always forces these off.
USE_LIVE_ISV_FABRIC=false
USE_LIVE_ISV_FOUNDRY=false
USE_LIVE_ISV_WEB=false
USE_LIVE_ISV_WORK=false

# API authentication
AZURE_TENANT_ID=your-tenant-id
API_AUDIENCE=api://your-api-client-id
API_REQUIRED_SCOPE=access_as_user

# Fabric IQ
ISV_FABRIC_WORKSPACE_ID=your-isv-fabric-workspace-id
ISV_FABRIC_DATA_AGENT_ID=your-isv-fabric-data-agent-id
ISV_FABRIC_LAKEHOUSE_ID=your-isv-lakehouse-id
ISV_FABRIC_ONTOLOGY_ID=your-isv-ontology-id
FABRIC_API_SCOPE=https://api.fabric.microsoft.com/.default

# Foundry IQ and Search-backed Web IQ fallback
ISV_SEARCH_ENDPOINT=https://your-isv-search.search.windows.net
ISV_FOUNDRY_KB_NAME=your-isv-renewal-knowledge-base
ISV_WEB_KB_NAME=your-isv-web-knowledge-base
ISV_SEARCH_API_VERSION=2026-05-01-preview

# Native Microsoft Web IQ. Leave the key blank to use the Search fallback.
ISV_WEB_IQ_ENDPOINT=https://api.microsoft.ai/v3/search/web
ISV_WEB_IQ_API_KEY=

# Work IQ delegated/OBO application
WORK_IQ_ENDPOINT=https://workiq.svc.cloud.microsoft/a2a/
WORK_IQ_SCOPE=api://workiq.svc.cloud.microsoft/.default
WORK_IQ_CLIENT_ID=your-work-iq-client-id
WORK_IQ_TIMEOUT_SECONDS=240

# Production certificate injection, or Key Vault retrieval when PFX is blank
WORK_IQ_CLIENT_CERTIFICATE_PFX=
AZURE_CLIENT_ID=your-container-app-managed-identity-client-id
WORK_IQ_KEY_VAULT_URL=https://your-key-vault.vault.azure.net/
WORK_IQ_CLIENT_CERTIFICATE_SECRET_NAME=your-work-iq-certificate-secret

# Local connected Work IQ certificate
WORK_IQ_CLIENT_CERTIFICATE=
WORK_IQ_CLIENT_CERTIFICATE_THUMBPRINT=
WORK_IQ_CLIENT_PUBLIC_CERTIFICATE=

# Optional Fabric capacity status chip
AZURE_SUBSCRIPTION_ID=your-subscription-id
FABRIC_CAPACITY_RG=your-fabric-capacity-resource-group
FABRIC_CAPACITY_NAME=your-fabric-capacity-name
